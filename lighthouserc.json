{
	"ci": {
		"collect": {
			"staticDistDir": "./.vercel/output/static",
			"url": [
				"http://localhost/index.html",
				"http://localhost/identify/index.html",
				"http://localhost/missions/index.html",
				"http://localhost/quiz/index.html",
				"http://localhost/learn/index.html",
				"http://localhost/grove/index.html",
				"http://localhost/species/oak/index.html"
			],
			"numberOfRuns": 1
		},
		"assert": {
			"assertions": {
				"categories:accessibility": [
					"error",
					{
						"minScore": 1
					}
				],
				"categories:best-practices": [
					"warn",
					{
						"minScore": 0.9
					}
				],
				"categories:performance": [
					"warn",
					{
						"minScore": 0.8
					}
				]
			}
		}
	}
}
